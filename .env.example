# Supabase Configuration
# Copy this file to .env and fill in your values

# Supabase Project URL
VITE_SUPABASE_URL=your_supabase_project_url.supabase.co

# Supabase Anonymous Key (anon public key)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Admin Telegram IDs (comma separated)
VITE_ADMIN_IDS=your_admin_telegram_id

# Telegram Bot Token (for sending notifications)
VITE_BOT_TOKEN=your_bot_token

# Storage Bucket Name
VITE_STORAGE_BUCKET=barber-images